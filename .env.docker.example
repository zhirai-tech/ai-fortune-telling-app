# 你现有自托管 Supabase 的对外访问根地址（通常是 Kong 暴露的地址）
# 示例：https://supabase.example.com
# 如果是“宿主机上运行”的 Supabase，容器内请用 http://host.docker.internal:54321
SUPABASE_UPSTREAM_URL=

# 你现有 Supabase 的 key（从你的 Supabase 部署环境变量/配置中获取）
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 可选：模型配置（若数据库里已通过 ai_provider_configs 配好默认模型，可不填）
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

