PORT=3000
CORS_ORIGIN=http://localhost:5173

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=yijing

JWT_SECRET=please_change_me

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google console redirect URI, typically: https://api-temp.yourdomain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Frontend origin for final redirect, e.g. https://yourdomain.com
FRONTEND_BASE_URL=

# Static frontend directory for Node to serve (relative to app working dir). Example: ../public_html
FRONTEND_DIR=

# Daily fortunes generation
CRON_TOKEN=

# Optional fallback AI config (if ai_provider_configs is empty)
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
